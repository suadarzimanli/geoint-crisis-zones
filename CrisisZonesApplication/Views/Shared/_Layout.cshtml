<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Crisis Zones: ACLED conflict and protest events in Poland, 2020–2024, on an interactive map with city-level forecasts." />
    <meta name="theme-color" content="#14213d" />
    <meta name="color-scheme" content="light dark" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <title>@(ViewData["Title"] is string t ? t + " · Crisis Zones" : "Crisis Zones")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
        <a class="brand" href="/" aria-label="Crisis Zones home">
            <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/></svg>
            <span class="brand-text"><strong>Crisis Zones</strong><span class="brand-sub">Poland · ACLED events 2020–2024</span></span>
        </a>
        <nav class="topnav" aria-label="Main">
            <a href="/" class="@(ViewContext.RouteData.Values["action"] as string == "Index" ? "active" : null)">Map</a>
            <a href="/about" class="@(ViewContext.RouteData.Values["action"] as string == "About" ? "active" : null)">About &amp; data</a>
            <button type="button" id="theme-toggle" class="theme-toggle" aria-pressed="false" aria-label="Switch to dark mode">
                <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
        </nav>
    </header>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

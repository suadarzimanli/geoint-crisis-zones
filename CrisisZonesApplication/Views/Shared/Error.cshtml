@model ErrorViewModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Page not found" : "Error";
}
<main id="main" class="page">
    @if (Model.IsNotFound)
    {
        <h1>Page not found</h1>
        <p class="lead">There is no page at this address. Go to the <a href="/">map</a> or read <a href="/about">about the data</a>.</p>
    }
    else
    {
        <h1>Something went wrong</h1>
        <p class="lead">The page could not be shown. Please go back to the <a href="/">map</a> and try again.</p>
    }
    @if (Model.ShowRequestId)
    {
        <p class="muted small">Reference: <code>@Model.RequestId</code></p>
    }
</main>

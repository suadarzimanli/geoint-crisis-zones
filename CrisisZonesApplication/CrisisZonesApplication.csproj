<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrisisZonesApplication.Tests" />
  </ItemGroup>

  <!-- Local data and secrets are never published with the app -->
  <ItemGroup>
    <Content Remove="App_Data\**" />
    <Content Update="appsettings.Development.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
